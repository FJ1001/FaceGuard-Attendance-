# ─────────────────────────────────────────────────────────────
#  EyeAmHere — AI Attendance System  |  .env.example
#  Copy this file to .env and replace placeholder values.
# ─────────────────────────────────────────────────────────────

APP_ENV=development

# ── Security (required) ──────────────────────────────────────
# Generate strong values:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_STRING
SALT=REPLACE_WITH_RANDOM_16_CHAR_STRING

# ── Admin bootstrap (required) ───────────────────────────────
ADMIN_EMAIL=admin@yourinstitution.edu
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12_CHARS
ADMIN_ROLE=admin

# ── Auth / Session ────────────────────────────────────────────
TOKEN_EXPIRY_HOURS=1
MIN_PASSWORD_LENGTH=8
ENABLE_ADMIN_2FA=false
PASSWORD_RESET_MAX_PER_HOUR=5

# ── Face Recognition ──────────────────────────────────────────
MODEL_NAME=ArcFace
DETECTOR_BACKEND=retinaface
EMBEDDING_SIZE=512
RECOGNITION_THRESHOLD=0.45
RECOGNITION_MARGIN=0.06
ALLOW_SKIP_DETECTION_FALLBACK=true

# ── Mask Detection ────────────────────────────────────────────
# Set MASK_USE_YOLO=false for CPU-only machines (faster)
MASK_USE_YOLO=false
MASK_FRAME_SKIP=2
MASK_BLOCK_UNCERTAIN=false
ATTENDANCE_MASK_CHECK_ENABLED=true

# ── Focus Monitoring ──────────────────────────────────────────
FOCUS_MONITORING_ENABLED=true
FOCUS_ALERT_THRESHOLD=45
FOCUS_WARNING_THRESHOLD=70

# ── Biometric Cache ───────────────────────────────────────────
BIOMETRIC_CACHE_ENABLED=false

# ── Email / SMTP (optional) ───────────────────────────────────
SMTP_ENABLED=false
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_app_password
